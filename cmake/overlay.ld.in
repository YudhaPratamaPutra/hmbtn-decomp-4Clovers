/* @NAME@ (@LIST_FILE@) */
.@NAME@ overlay_@REGION@ : SUBALIGN(4)
{
    @HEADER@(.data);  /* the header word */
@RODATA@
@TEXT@
@DATA@
    . = ALIGN(., 4);
    __mips_trampoline_start = .;
    KEEP(*(.mips_trampoline))
    __mips_trampoline_end = .;
@BSS@
    . = ALIGN(., 0x800);  /* the A_FILE member is whole sectors */
}
